<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.macdeck.adbtunnel</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/amandobriyal/Applications/MacDeck.app/Contents/MacOS/adb-tunnel-keeper.sh</string>
  </array>

  <!-- Start at login, restart if it ever crashes -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>/tmp/macdeck-adb.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/macdeck-adb.err</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/amandobriyal</string>
  </dict>
</dict>
</plist>
